# Copy to .env and fill in values
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Optional; vision reads inscription photos — defaults to OPENAI_CHAT_MODEL if blank (needs vision-capable model)
OPENAI_VISION_MODEL=gpt-4o-mini

# local = free Chroma ONNX embeddings (no OpenAI quota)
# openai = OpenAI embedding API
EMBEDDING_PROVIDER=local

# openai (default) = ChatGPT for all agents — requires OPENAI_API_KEY
# local = no ChatGPT; replies are raw archive excerpts only (offline demo)
LLM_PROVIDER=openai

CHROMA_PERSIST_DIRECTORY=chroma_db
CHROMA_COLLECTION_NAME=tamil_history
